# 复制为 .env 并修改（切勿提交真实密钥）
# 对外基础地址（用于 OIDC issuer、激活链接、ntfy 公共地址）
PUBLIC_BASE_URL=https://oa.example.com
APP_NAME=社团 OA
TZ=Asia/Shanghai

# 端口
HTTP_PORT=80
HTTPS_PORT=443

# 数据库
POSTGRES_PASSWORD=change-me
POSTGRES_DB=club_oa

# 内部服务令牌（所有服务共用同一密钥）
INTERNAL_SERVICE_SECRET=change-me-too

# 开发模式（关闭证书校验、日志邮件、返回激活链接等；生产必须 false）
DEV_MODE=false

# 首个超级管理员（仅用户表为空时创建；密码为空则随机生成并在日志打印）
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=

# ntfy 发布令牌（在 ntfy 中创建后填入；为空则匿名发布，仅限内网）
NTFY_TOKEN=

# 日志级别
RUST_LOG=info
