{
  "name": "club-oa",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "社团 OA 单仓库：Rust workspace（libs + services）+ pnpm workspace（apps + packages）",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter club-oa-web dev",
    "build": "pnpm --filter club-oa-web build",
    "preview": "pnpm --filter club-oa-web preview",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter './packages/*' typecheck",
    "typecheck:web": "pnpm --filter club-oa-web typecheck",
    "dev:electron": "pnpm --filter club-oa-electron dev",
    "dist:electron": "pnpm --filter club-oa-electron dist"
  }
}
